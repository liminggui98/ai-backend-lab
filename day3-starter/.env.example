# 复制成 .env 使用，不要提交到 git（已在根目录 .gitignore 里）

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# ---------- 智谱 ----------
ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-4-flash

# ---------- 阿里百炼（专属业务空间）----------
# 空间级 key 必须配空间级域名，混用会 403 AccessDenied.Unpurchased
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://ws-xxx.cn-xxx.maas.aliyuncs.com/compatible-mode/v1
# BAILIAN_MODEL=qwen-plus
