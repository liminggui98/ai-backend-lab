# 复制成 .env 使用，不要提交到 git（已在根目录 .gitignore 里）
#
# 和 Day 1 的区别：每个 provider 用自己前缀的变量，不再共用 LLM_BASE_URL / LLM_MODEL。
# Day 1 的坑：三段 LLM_* 全开时 `set -a; source .env` 只有最后一段生效，
# 以为在测 DeepSeek，其实打的是百炼。

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---------- 智谱 ----------
ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-4-flash

# ---------- 阿里百炼（专属业务空间）----------
# 空间级 key 必须配空间级域名，混用会 403 AccessDenied.Unpurchased
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# BAILIAN_MODEL=qwen-plus
