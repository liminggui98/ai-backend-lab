# 复制成 .env 使用

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REQUEST_TIMEOUT=60
DEEPSEEK_CONNECT_TIMEOUT=10
DEEPSEEK_TEMPERATURE=0.7

# ---------- 智谱 ----------
ZHIPU_API_KEY=xxx
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash
ZHIPU_REQUEST_TIMEOUT=60
ZHIPU_CONNECT_TIMEOUT=10
ZHIPU_TEMPERATURE=0.7

# ---------- 阿里百炼（专属业务空间，注意域名和 key 都是空间级的）----------
BAILIAN_API_KEY=sk-ws-xxxx
BAILIAN_BASE_URL=https://ws-xxx.cn-xxx.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
BAILIAN_REQUEST_TIMEOUT=60
BAILIAN_CONNECT_TIMEOUT=10
BAILIAN_TEMPERATURE=0.7